# Use the real, provisioned Neon resource. Never commit real credentials.
DHUN_DATABASE_URL=
DHUN_NEON_AUTH_BASE_URL=
DHUN_COOKIE_SECRET=
DHUN_RATE_SECRET=
DHUN_OWNER_EMAIL=
DHUN_PUBLIC_URL=http://localhost:3000
# Public Google Web client ID. Never put a Google client secret in the app/repo.
DHUN_GOOGLE_WEB_CLIENT_ID=
# Enable only after Google Android registration and the managed provider match.
DHUN_NATIVE_GOOGLE_ENABLED=false
